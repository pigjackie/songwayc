rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null; }
    function isOwner(uid) { return isAuthed() && request.auth.uid == uid; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isAuthed() && role() == 'Admin'; }

    match /users/{uid} {
      allow read: if isAuthed();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /schedules/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    match /attendanceRecords/{id} {
      allow read: if isAuthed();
      allow create, update: if isAuthed();
      allow delete: if isAdmin();
    }

    match /classLogs/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if isAdmin();
    }

    match /institutes/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    match /classMessageBoards/{classId} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthed();
        allow create: if isAuthed();
        allow update, delete: if isAdmin();
      }
    }

    match /todos/{id} {
      allow read: if isAuthed();
      allow create, delete: if isAdmin();
      allow update: if isAuthed();
    }

    match /salaryConfigs/{teacherId} {
      allow read: if isAdmin() || isOwner(teacherId);
      allow create, update, delete: if isAdmin();
    }

    match /salarySettlements/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
